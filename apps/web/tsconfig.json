{
  // Paylaşılan katı derleyici tabanı @repo/config'ten gelir (ADR-0023 madde 1, Faz 4.5
  // commit 3). `paths`/`include`/`exclude` BURADA KALIR: TypeScript bunları bildiren
  // dosyanın konumuna göre çözer — paylaşılan config'e taşınsaydı `@/*` kırılırdı.
  "extends": "@repo/config/tsconfig/next.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "vitest.setup.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", "tests/e2e", ".next", "ai_backend"]
}
