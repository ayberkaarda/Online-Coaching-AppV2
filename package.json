{
  "name": "my-coaching-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.19.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm --filter web run dev",
    "start": "pnpm --filter web run start",
    "dev:hosted": "pnpm --filter web run dev:hosted",
    "build:hosted": "pnpm --filter web run build:hosted",
    "start:hosted": "pnpm --filter web run start:hosted",
    "build": "turbo run build --filter=!mobile",
    "lint": "turbo run lint --filter=!mobile",
    "lint:fix": "turbo run lint:fix --filter=!mobile",
    "type-check": "turbo run type-check --filter=!mobile",
    "type-check:e2e": "turbo run type-check:e2e --filter=!mobile",
    "test": "turbo run test --filter=!mobile",
    "test:coverage": "turbo run test:coverage --filter=!mobile",
    "test:watch": "pnpm --filter web run test:watch",
    "test:e2e": "pnpm --filter web run test:e2e",
    "test:e2e:ui": "pnpm --filter web run test:e2e:ui",
    "mobile:lint": "turbo run lint --filter=mobile",
    "mobile:type-check": "turbo run type-check --filter=mobile",
    "mobile:export": "pnpm --filter mobile run export",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:types": "pnpm --filter @repo/types run db:types",
    "db:migrate": "supabase db push",
    "clean:foods": "node scripts/clean-foods.mjs",
    "db:import-catalog": "node scripts/import-catalog.mjs",
    "db:clean-e2e": "dotenv -e apps/web/.env.local -- node scripts/clean-e2e-data.mjs",
    "test:rls": "docker exec -i supabase_db_my-coaching-app psql -U postgres -d postgres -v ON_ERROR_STOP=1 -f - < supabase/tests/rls.test.sql",
    "test:transform": "docker exec -i supabase_db_my-coaching-app psql -U postgres -d postgres -v ON_ERROR_STOP=1 -f - < supabase/tests/transform.test.sql",
    "ratchet": "node scripts/identity-ratchet.mjs",
    "ci": "pnpm run lint && pnpm run type-check && pnpm run test && pnpm run build"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ],
    "packageExtensions": {
      "eslint-config-next": {
        "peerDependencies": {
          "next": "*"
        }
      }
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-w3rx-r6r6-pgpr",
        "GHSA-5p2g-fcmc-qvqq"
      ]
    }
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.110.0",
    "dotenv-cli": "^11.0.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "supabase": "^2.2.1",
    "turbo": "^2.10.11"
  }
}
