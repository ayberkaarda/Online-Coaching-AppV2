# `next-pwa` v5 kendi bağımlılıkları arasında `webpack`i bildirmeden `require('webpack')`
# yapıyor (hayalet bağımlılık). Bugüne kadar bu boşluğu npm'in peer otomatik kurulumu
# kapatıyordu; pnpm'de aynı işi bu ayar görür. pnpm 8+ için zaten varsayılan olsa da
# açıkça yazılır — varsayılanın ileride değişmesi PWA/webpack zincirini sessizce kırardı.
auto-install-peers=true

# Kazara çalıştırılan bir `npm install`ın `package-lock.json`ı geri üretmesini keser;
# tek gerçek kilit dosyası `pnpm-lock.yaml` olarak kalır.
package-lock=false

# ZORUNLU EŞLİKÇİ — SİLMEYİN. pnpm, npm ile geriye dönük uyumluluk için
# `package-lock=false` ayarını KENDİ `lockfile` ayarına da uyguluyor; yalnızca yukarıdaki
# satır bırakılırsa `pnpm import` "Cannot generate a pnpm-lock.yaml because lockfile is set
# to false" (ERR_PNPM_CONFIG_CONFLICT_LOCKFILE_ONLY_WITH_NO_LOCKFILE) ile düşer ve
# `pnpm install` kilit dosyasını hiç yazmaz. Açık `lockfile=true` bu devralmayı geçersiz
# kılar: npm kilitsiz kalır, pnpm kendi kilidini yazmaya devam eder. (pnpm 10.34.5'te
# ölçüldü.)
lockfile=true
