# Bu dosya bir ŞABLONDUR — gerçek sır İÇERMEZ.
# Kopyalayıp `.env.local` olarak kaydedin ve kendi değerlerinizi girin.
# `.env.local` .gitignore'da (`.env*` deseni) zaten hariç tutulmuştur, commit'lenmez.

# ---- Supabase (client) ----
# Supabase proje URL'i (Project Settings > API). İstemci tarafında (browser) kullanılır.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Supabase anon/public API anahtarı. RLS ile korunur, istemciye açık olması güvenlidir.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# ---- Supabase (server-only, ASLA client'a sızmamalı) ----
# RLS'yi bypass eden servis rolü anahtarı. Yalnızca server-side (API route/server action) kullanılmalı.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---- AI Backend (server-only proxy hedefi) ----
# FastAPI AI backend servisinin adresi. Next.js server tarafından proxy edilir, browser'a açılmaz.
AI_BACKEND_URL=http://localhost:8000
# AI backend'e istek atarken kullanılacak API anahtarı; ai_backend'in kendi API_KEY değişkeniyle
# AYNI olmalı. Dev/test'te boş bırakılabilir, ancak NODE_ENV=production iken ZORUNLUDUR
# (src/env.ts fail-fast eder) — aksi halde AI backend guard'ı kimliksiz isteklere açık kalabilir.
AI_BACKEND_API_KEY=

# ---- Uygulama ----
# Uygulamanın herkese açık base URL'i (ör. e-posta linkleri, absolute URL üretimi için).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Node/Next.js ortam modu: development | production | test
NODE_ENV=development
# pino logger seviyesi: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ---- Rate limiting ----
# Rate limit penceresi (milisaniye).
RATE_LIMIT_WINDOW_MS=60000
# Pencere başına izin verilen maksimum istek sayısı.
RATE_LIMIT_MAX_REQUESTS=60
# Kaç GÜVENİLEN ters proxy'nin (reverse proxy) X-Forwarded-For zincirine kendi gördüğü IP'yi
# eklediği. VARSAYILAN 0: hiçbir başlığa güvenilmez, istemci XFF'i serbestçe ayarlayabildiği için
# (bkz. docs/security/findings-app-surface.md A-02). Vercel gibi tek-hop güvenilir bir edge'in
# arkasındaysanız 1 yapın; kendi nginx/Caddy reverse proxy'niz varsa kendi zincirinizdeki
# güvenilir hop sayısını girin. YANLIŞ AYARLAMAK GÜVENSİZDİR — emin değilseniz 0 bırakın.
TRUSTED_PROXY_COUNT=0

# ---- Giriş kaba kuvvet koruması (A-01) ----
# Giriş uçundaki (/api/auth/sign-in) kaba kuvvet sınırı ENV İLE AYARLANMAZ; eşikler kodda
# sabittir (src/lib/api/auth-rate-limit.ts): NORMALİZE EDİLMİŞ E-POSTA başına 10 BAŞARISIZ
# deneme / 15 dakika. Kasıtlı bir karardır — yanlışlıkla zayıflatılabilecek bir güvenlik
# eşiği olmasın diye.
# NEDEN UYGULAMA KATMANI: supabase/config.toml'daki [auth.rate_limit] konteynere ULAŞIYOR ama
# GoTrue tarafından /token?grant_type=password için FİİLEN UYGULANMIYOR (açık upstream hatası:
# github.com/supabase/supabase/issues/41947). Canlı ölçüm: 180 ardışık yanlış şifre → 180/180
# HTTP 400, sıfır 429. config.toml yapılandırması KALDIRILMADI; upstream düzelirse ikinci
# katman olarak çalışır.
# Anahtar IP DEĞİL e-postadır: TRUSTED_PROXY_COUNT=0 iken tüm istekler tek paylaşılan kovaya
# düştüğü için IP tabanlı bir giriş kilidi TÜM kullanıcıları kilitleyen bir DoS koluna
# dönüşürdü. İkincil IP kovası (300 başarısız deneme / 15 dk) YALNIZCA TRUSTED_PROXY_COUNT > 0
# olduğunda, yani gerçekten bir istemci IP'si çözülebildiğinde uygulanır.
