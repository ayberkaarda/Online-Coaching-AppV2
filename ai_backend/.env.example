# FastAPI AI backend ortam değişkenleri örneği.
#
# Kullanım: bu dosyayı `.env` olarak kopyalayın ve değerleri doldurun.
#   cp .env.example .env
#
# `.env` dosyası `.gitignore`'da (`.env*` deseniyle) — commit edilmez, gerçek sır
# içerebilir. Bu örnek dosya gerçek sır İÇERMEZ ve sürüm kontrolünde kalmalıdır
# (bkz. audit bulgusu A-22 — kök `.gitignore`'a `!.env.example` eklenmesi ayrı bir
# ajanın kapsamında; bu dosya eklendiğinde aynı istisnanın `ai_backend/.env.example`
# için de tanımlanması gerekir, aksi halde bu dosya da yanlışlıkla ignore edilir).

# development | staging | production
# production iken API_KEY ayarlanmadan başlatma REDDEDİLİR (fail-closed guard, A-04).
# production iken /docs, /redoc, /openapi.json de kapanır (A-13).
ENVIRONMENT=development

# Virgülle ayrılmış izinli origin listesi (allowlist — asla "*" kullanmayın).
CORS_ORIGINS=http://localhost:3000

# /analyze/*, /recommendations, /api/generate-ai-workout, /api/generate-ai-diet
# uçları için zorunlu X-API-Key header değeri. Next.js proxy'sindeki
# AI_BACKEND_API_KEY ile BİREBİR AYNI olmalıdır (src/env.ts). Production'da
# zorunludur; development/staging'de boş bırakılırsa guard no-op çalışır
# (başlangıçta bir uyarı loglanır).
API_KEY=

# slowapi genel istek sınırı. /analyze/*, /recommendations ve deprecated
# /api/generate-ai-workout, /api/generate-ai-diet uçları ayrıca 20/minute ile
# sınırlıdır (bu sabit koddadır, env değişkeni değildir). /health, /health/ready
# muaftır.
RATE_LIMIT=60/minute

# structlog log seviyesi.
LOG_LEVEL=INFO

# true ise JSON log (production için önerilir), false ise renkli konsol çıktısı
# (yerel geliştirme için daha okunaklı).
LOG_JSON=true
