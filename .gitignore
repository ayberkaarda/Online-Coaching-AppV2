# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/
playwright-report/
test-results/
.vitest/

# next.js
.next/
out/

# next-pwa tarafından build sırasında üretilir — commit edilmez
**/public/sw.js
**/public/sw.js.map
**/public/workbox-*.js
**/public/workbox-*.js.map
**/public/fallback-*.js

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# ...ama .env.example dosyaları kurulum dokümantasyonudur, kök ve alt dizinlerde takip edilsin
!.env.example
!**/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python (ai_backend)
.venv/
__pycache__/
*.pyc
.ruff_cache/
.mypy_cache/
.pytest_cache/

# pytest --cov tarafından üretilir (ai_backend) — /coverage Vitest'in çıktısıdır, bu ayrı
.coverage
.coverage.*
coverage.xml
htmlcov/

# editors
.idea/
.vscode/*
!.vscode/extensions.json

# docker
docker-compose.override.yml

# supabase (local stack scratch files — contains generated secrets)
supabase/.temp/
supabase/.branches/

# turbo (Faz 4.5 commit 7b) — yerel görev önbelleği ve daemon log/soket dosyaları
.turbo/

# hosted Supabase yedekleri (B-030) — kişisel veri taşır, KVKK gereği repoya asla girmez, bkz. docs/ops/hosted-backup.md
backups/
